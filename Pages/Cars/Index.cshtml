@page "/"
@model Carbase.Pages.Cars.IndexModel
@using Carbase.Models.Filters
@using Carbase.Models.Sorting

@{
    var hasActiveNumericFilters =
        Model.Filter.Year.Type != NumericFilterType.All ||
        Model.Filter.WeightKg.Type != NumericFilterType.All ||
        Model.Filter.HorsePower.Type != NumericFilterType.All ||
        Model.Filter.TorqueNm.Type != NumericFilterType.All ||
        Model.Filter.TopSpeed.Type != NumericFilterType.All ||
        Model.Filter.Time0To100.Type != NumericFilterType.All ||
        Model.Filter.Time100To200.Type != NumericFilterType.All ||
        Model.Filter.Time200To250.Type != NumericFilterType.All ||
        Model.Filter.TimeQuarterMile.Type != NumericFilterType.All;
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="mb-1">Cars</h1>
        <p class="text-muted mb-0">
            Browse and manage cars in the database.
        </p>
    </div>

    <a asp-page="./Create"
       class="btn btn-primary">
        + Add car
    </a>
</div>

<form method="get"
      id="carsFilterForm">

    <input type="hidden"
           asp-for="Sort.Field"
           id="sortField" />

    <input type="hidden"
           asp-for="Sort.Direction"
           id="sortDirection" />

    <input type="hidden"
           asp-for="PageNumber"
           id="pageNumber" />

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="mb-1">Filters</h5>
                    <small class="text-muted">
                        Narrow down the list of cars.
                    </small>
                </div>
            </div>

            <div class="row g-3">

                <div class="col-12 col-md-6 col-xl-3">
                    <label asp-for="Filter.Brand"
                           class="form-label fw-semibold">
                        Brand
                    </label>

                    <input asp-for="Filter.Brand"
                           class="form-control"
                           placeholder="e.g. BMW" />
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label asp-for="Filter.Model"
                           class="form-label fw-semibold">
                        Model
                    </label>

                    <input asp-for="Filter.Model"
                           class="form-control"
                           placeholder="e.g. M3" />
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label asp-for="Filter.TunerStatus"
                           class="form-label fw-semibold">
                        Tuner
                    </label>

                    <select asp-for="Filter.TunerStatus"
                            id="tunerStatus"
                            class="form-select">
                        <option value="All">All</option>
                        <option value="With">With tuner</option>
                        <option value="Without">Without tuner</option>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-xl-3 d-none"
                     id="tunerNameContainer">

                    <label asp-for="Filter.Tuner"
                           class="form-label fw-semibold">
                        Tuner name
                    </label>

                    <input asp-for="Filter.Tuner"
                           id="tunerName"
                           class="form-control"
                           placeholder="e.g. Brabus" />
                </div>

            </div>

            <div class="mt-4">
                <button class="btn btn-outline-secondary"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#advancedFilters"
                        aria-expanded="@(hasActiveNumericFilters ? "true" : "false")"
                        aria-controls="advancedFilters">
                    Advanced filters
                </button>
            </div>

            <div class="collapse mt-4 @(hasActiveNumericFilters ? "show" : "")"
                id="advancedFilters">

                <div class="border-top pt-4">

                    <h6 class="text-muted mb-3">
                        Technical specifications
                    </h6>

                    <div class="row g-3">

                        @await Html.PartialAsync(
                            "_NumericFilter",
                            new NumericFilterPartialModel
                            {
                                Label = "Year",
                                Prefix = "Filter.Year",
                                Type = Model.Filter.Year.Type,
                                Value = Model.Filter.Year.Value,
                                From = Model.Filter.Year.From,
                                To = Model.Filter.Year.To,
                                AllowPresence = false
                            })

                        @await Html.PartialAsync(
                            "_NumericFilter",
                            new NumericFilterPartialModel
                            {
                                Label = "Weight [kg]",
                                Prefix = "Filter.WeightKg",
                                Type = Model.Filter.WeightKg.Type,
                                Value = Model.Filter.WeightKg.Value,
                                From = Model.Filter.WeightKg.From,
                                To = Model.Filter.WeightKg.To
                            })

                        @await Html.PartialAsync(
                            "_NumericFilter",
                            new NumericFilterPartialModel
                            {
                                Label = "Horse Power",
                                Prefix = "Filter.HorsePower",
                                Type = Model.Filter.HorsePower.Type,
                                Value = Model.Filter.HorsePower.Value,
                                From = Model.Filter.HorsePower.From,
                                To = Model.Filter.HorsePower.To
                            })

                        @await Html.PartialAsync(
                            "_NumericFilter",
                            new NumericFilterPartialModel
                            {
                                Label = "Torque [Nm]",
                                Prefix = "Filter.TorqueNm",
                                Type = Model.Filter.TorqueNm.Type,
                                Value = Model.Filter.TorqueNm.Value,
                                From = Model.Filter.TorqueNm.From,
                                To = Model.Filter.TorqueNm.To
                            })

                        @await Html.PartialAsync(
                            "_NumericFilter",
                            new NumericFilterPartialModel
                            {
                                Label = "Top Speed [km/h]",
                                Prefix = "Filter.TopSpeed",
                                Type = Model.Filter.TopSpeed.Type,
                                Value = Model.Filter.TopSpeed.Value,
                                From = Model.Filter.TopSpeed.From,
                                To = Model.Filter.TopSpeed.To
                            })

                    </div>

                    <h6 class="text-muted mt-4 mb-3">
                        Acceleration times
                    </h6>

                    <div class="row g-3">

                        @await Html.PartialAsync(
                            "_NumericFilter",
                            new NumericFilterPartialModel
                            {
                                Label = "0-100 [s]",
                                Prefix = "Filter.Time0To100",
                                Type = Model.Filter.Time0To100.Type,
                                Value = Model.Filter.Time0To100.Value,
                                From = Model.Filter.Time0To100.From,
                                To = Model.Filter.Time0To100.To
                            })

                        @await Html.PartialAsync(
                            "_NumericFilter",
                            new NumericFilterPartialModel
                            {
                                Label = "100-200 [s]",
                                Prefix = "Filter.Time100To200",
                                Type = Model.Filter.Time100To200.Type,
                                Value = Model.Filter.Time100To200.Value,
                                From = Model.Filter.Time100To200.From,
                                To = Model.Filter.Time100To200.To
                            })

                        @await Html.PartialAsync(
                            "_NumericFilter",
                            new NumericFilterPartialModel
                            {
                                Label = "200-250 [s]",
                                Prefix = "Filter.Time200To250",
                                Type = Model.Filter.Time200To250.Type,
                                Value = Model.Filter.Time200To250.Value,
                                From = Model.Filter.Time200To250.From,
                                To = Model.Filter.Time200To250.To
                            })

                        @await Html.PartialAsync(
                            "_NumericFilter",
                            new NumericFilterPartialModel
                            {
                                Label = "1/4 Mile [s]",
                                Prefix = "Filter.TimeQuarterMile",
                                Type = Model.Filter.TimeQuarterMile.Type,
                                Value = Model.Filter.TimeQuarterMile.Value,
                                From = Model.Filter.TimeQuarterMile.From,
                                To = Model.Filter.TimeQuarterMile.To
                            })

                    </div>

                </div>

            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">

                <a asp-page="./Index"
                   id="clearFilters"
                   class="btn btn-outline-secondary">
                    Clear
                </a>

                <button type="submit"
                        class="btn btn-primary">
                    Apply filters
                </button>

            </div>

        </div>
    </div>

    @{
        var firstItem = Model.Cars.Any()
            ? (Model.PageNumber - 1) * Model.PageSize + 1
            : 0;

        var lastItem = Model.Cars.Any()
            ? firstItem + Model.Cars.Count - 1
            : 0;
    }

    <div class="d-flex flex-column flex-md-row
                justify-content-between align-items-md-center
                gap-3 mb-3">

        <div class="text-muted">
            @if (Model.Cars.Any())
            {
                <span>
                    Showing
                    <strong>@firstItem-@lastItem</strong>
                    of
                    <strong>@Model.TotalItems</strong>
                    cars
                </span>
            }
            else
            {
                <span>
                    No matching cars
                </span>
            }
        </div>

        <div class="d-flex align-items-center gap-2">
            <label for="pageSize"
                   class="text-muted mb-0">
                Rows per page:
            </label>

            <select asp-for="PageSize"
                    id="pageSize"
                    class="form-select form-select-sm"
                    style="width:auto;">
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>

    </div>

</form>

@if (!Model.Cars.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">

            <h5 class="mb-2">
                No cars found
            </h5>

            <p class="text-muted mb-0">
                Try changing or clearing the active filters.
            </p>

        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">

        <div id="tableTopScroll"
             class="overflow-x-auto mb-2">

            <div id="tableTopScrollContent"
                 style="height:1px;">
            </div>

        </div>

        <div class="table-responsive"
            id="tableScroll">

            <table class="table table-hover align-middle mb-0 cars-table">

                <thead class="table-light">
                    <tr>

                        <th>
                            Actions
                        </th>

                        <th class="ps-3">
                            Image
                        </th>

                        <th>
                            Brand
                        </th>

                        <th>
                            Model
                        </th>

                        <th>
                            <button type="button"
                                    class="sort-header border-0 bg-transparent p-0 fw-semibold text-dark"
                                    data-sort-field="Year">
                                Year

                                @if (Model.Sort.Field == CarSortField.Year)
                                {
                                    @(Model.Sort.Direction == SortDirection.Ascending
                                        ? "↑"
                                        : "↓")
                                }
                            </button>
                        </th>

                        <th>
                            Tuner
                        </th>

                        <th>
                            <button type="button"
                                    class="sort-header border-0 bg-transparent p-0 fw-semibold text-dark"
                                    data-sort-field="WeightKg">
                                Weight [kg]

                                @if (Model.Sort.Field == CarSortField.WeightKg)
                                {
                                    @(Model.Sort.Direction == SortDirection.Ascending
                                        ? "↑"
                                        : "↓")
                                }
                            </button>
                        </th>

                        <th>
                            <button type="button"
                                    class="sort-header border-0 bg-transparent p-0 fw-semibold text-dark"
                                    data-sort-field="HorsePower">
                                Horse Power

                                @if (Model.Sort.Field == CarSortField.HorsePower)
                                {
                                    @(Model.Sort.Direction == SortDirection.Ascending
                                        ? "↑"
                                        : "↓")
                                }
                            </button>
                        </th>

                        <th>
                            <button type="button"
                                    class="sort-header border-0 bg-transparent p-0 fw-semibold text-dark"
                                    data-sort-field="TorqueNm">
                                Torque [Nm]

                                @if (Model.Sort.Field == CarSortField.TorqueNm)
                                {
                                    @(Model.Sort.Direction == SortDirection.Ascending
                                        ? "↑"
                                        : "↓")
                                }
                            </button>
                        </th>

                        <th>
                            <button type="button"
                                    class="sort-header border-0 bg-transparent p-0 fw-semibold text-dark"
                                    data-sort-field="TopSpeed">
                                Top Speed [km/h]

                                @if (Model.Sort.Field == CarSortField.TopSpeed)
                                {
                                    @(Model.Sort.Direction == SortDirection.Ascending
                                        ? "↑"
                                        : "↓")
                                }
                            </button>
                        </th>

                        <th>
                            <button type="button"
                                    class="sort-header border-0 bg-transparent p-0 fw-semibold text-dark"
                                    data-sort-field="Time0To100">
                                0-100 [s]

                                @if (Model.Sort.Field == CarSortField.Time0To100)
                                {
                                    @(Model.Sort.Direction == SortDirection.Ascending
                                        ? "↑"
                                        : "↓")
                                }
                            </button>
                        </th>

                        <th>
                            <button type="button"
                                    class="sort-header border-0 bg-transparent p-0 fw-semibold text-dark"
                                    data-sort-field="Time100To200">
                                100-200 [s]

                                @if (Model.Sort.Field == CarSortField.Time100To200)
                                {
                                    @(Model.Sort.Direction == SortDirection.Ascending
                                        ? "↑"
                                        : "↓")
                                }
                            </button>
                        </th>

                        <th>
                            <button type="button"
                                    class="sort-header border-0 bg-transparent p-0 fw-semibold text-dark"
                                    data-sort-field="Time200To250">
                                200-250 [s]

                                @if (Model.Sort.Field == CarSortField.Time200To250)
                                {
                                    @(Model.Sort.Direction == SortDirection.Ascending
                                        ? "↑"
                                        : "↓")
                                }
                            </button>
                        </th>

                        <th>
                            <button type="button"
                                    class="sort-header border-0 bg-transparent p-0 fw-semibold text-dark"
                                    data-sort-field="TimeQuarterMile">
                                1/4 Mile [s]

                                @if (Model.Sort.Field == CarSortField.TimeQuarterMile)
                                {
                                    @(Model.Sort.Direction == SortDirection.Ascending
                                        ? "↑"
                                        : "↓")
                                }
                            </button>
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @foreach (var car in Model.Cars)
                    {
                        <tr>

                            <td class="text-nowrap">
                                <div class="d-flex justify-content-center gap-2">

                                    <a asp-page="./Edit"
                                       asp-route-id="@car.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger delete-car-button"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteCarModal"
                                            data-car-id="@car.Id"
                                            data-car-brand="@car.Brand"
                                            data-car-model="@car.Model"
                                            data-car-year="@car.Year"
                                            data-car-tuner="@(string.IsNullOrWhiteSpace(car.Tuner) ? "None" : car.Tuner)">
                                        Delete
                                    </button>

                                </div>
                            </td>
                            <td class="ps-3">
                                <img src="@(string.IsNullOrWhiteSpace(car.ImagePath)
                                    ? "/images/empty-car.png"
                                    : car.ImagePath)"
                                     alt="@car.Brand @car.Model"
                                     class="rounded-3"
                                     style="width:120px;
                                            height:80px;
                                            object-fit:cover;" />
                            </td>

                            <td class="fw-semibold">
                                @NoBreakHyphens(car.Brand)
                            </td>

                            <td>
                                @NoBreakHyphens(car.Model)
                            </td>

                            <td>
                                @car.Year
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(car.Tuner)
                                    ? "—"
                                    : NoBreakHyphens(car.Tuner))
                            </td>

                            <td>
                                @(car.WeightKg?.ToString() ?? "—")
                            </td>

                            <td>
                                @(car.HorsePower?.ToString() ?? "—")
                            </td>

                            <td>
                                @(car.TorqueNm?.ToString() ?? "—")
                            </td>

                            <td>
                                @(car.TopSpeed?.ToString() ?? "—")
                            </td>

                            <td>
                                @(car.Time0To100?.ToString() ?? "—")
                            </td>

                            <td>
                                @(car.Time100To200?.ToString() ?? "—")
                            </td>

                            <td>
                                @(car.Time200To250?.ToString() ?? "—")
                            </td>

                            <td>
                                @(car.TimeQuarterMile?.ToString() ?? "—")
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}

<div class="modal fade"
     id="deleteCarModal"
     tabindex="-1"
     aria-labelledby="deleteCarModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title"
                    id="deleteCarModalLabel">
                    Delete car
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">

                <p>
                    Are you sure you want to delete this car?
                </p>

                <div class="border rounded p-3 bg-light">

                    <div class="fw-semibold fs-5"
                         id="deleteCarName">
                    </div>

                    <div class="text-muted mt-2">
                        Year:
                        <span id="deleteCarYear"></span>
                    </div>

                    <div class="text-muted">
                        Tuner:
                        <span id="deleteCarTuner"></span>
                    </div>

                </div>

                <p class="text-danger mt-3 mb-0">
                    This action cannot be undone.
                </p>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <form method="post"
                      asp-page-handler="Delete"
                      id="deleteCarForm">

                    <input type="hidden"
                           name="id"
                           id="deleteCarId" />

                    <button type="submit"
                            class="btn btn-danger">
                        Delete car
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

@if (Model.TotalPages > 1)
{
    
    const int maxVisiblePages = 5;

    var startPage = Math.Max(
        1,
        Model.PageNumber - maxVisiblePages / 2);

    var endPage = Math.Min(
        Model.TotalPages,
        startPage + maxVisiblePages - 1);

    startPage = Math.Max(
        1,
        endPage - maxVisiblePages + 1);

    <nav class="mt-4"
         aria-label="Cars pagination">

        <ul class="pagination justify-content-center">

            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                <button type="button"
                        class="page-link pagination-button"
                        data-page="@(Model.PageNumber - 1)">
                    Previous
                </button>
            </li>

            @for (var pageNumber = startPage;
                  pageNumber <= endPage;
                  pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.PageNumber ? "active" : "")">

                    <button type="button"
                            class="page-link pagination-button"
                            data-page="@pageNumber">
                        @pageNumber
                    </button>

                </li>
            }

            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">

                <button type="button"
                        class="page-link pagination-button"
                        data-page="@(Model.PageNumber + 1)">
                    Next
                </button>

            </li>

        </ul>

    </nav>
}

@section Scripts {
    <script src="~/js/cars-index.js"></script>
}

@functions {
    string NoBreakHyphens(string? value)
    {
        return value?.Replace("-", "\u2011") ?? "";
    }
}