{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carbase",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-07",
  "containers": [
    {
      "class_name": "CarbaseContainer",
      "image": "registry.cloudflare.com/7ee841e931ce82fe815167ccc8ec6946/carbase:cf",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CARBASE_CONTAINER",
        "class_name": "CarbaseContainer"
      }
    ]
  },
  "exports": {
    "CarbaseContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "ratelimits": [
    {
      "name": "CARBASE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
